# DJOUSSE TECH MD — modele de configuration
# Copier ce fichier vers .env, puis remplir les valeurs.
# Ne jamais committer .env.

BOT_NAME=DJOUSSE TECH MD
PREFIX=.
OWNER_NUMBER=
OWNER_NAME=DJOUSSE TECH
# Sessions, base locale, jeux et logs vivent dans storage/ (à monter en volume
# sur un hébergement cloud ; ne pas déplacer sans prévoir la persistance).
SESSION_BACKUP_KEY=

# --- IA (texte) ---
# Ordre d'utilisation : Anthropic -> Gemini -> Groq -> OpenRouter -> Pollinations.
# Laisser vide les cles inutilisees.
ANTHROPIC_API_KEY=
GEMINI_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Modeles (optionnel)
AV_GEMINI_MODEL=gemini-3-flash-preview
AV_GROQ_MODEL=qwen/qwen3.8-27b
AV_OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
AV_MODEL=claude-sonnet-4-5
TEXT_ENDPOINT=
AV_TEXT_MODEL=openai
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Autres services (optionnel) ---
ELEVENLABS_API_KEY=
AUDD_API_KEY=
REMOVEBG_API_KEY=
OMDB_API_KEY=
GNEWS_API_KEY=
SERPER_API_KEY=

# --- Jeu Action ou Verite ---
AV_AI=on
AV_AI_GAP_MS=46000
# Vide = cahier des charges (0 point si l'IA echoue). fallback = repli local. local = hors ligne.
AV_JUDGE=
# Plafond par tentative de jugement (l'API ne doit pas bloquer la partie).
AV_JUDGE_TIMEOUT_MS=25000
AV_LEVEL=soft
AV_ROUNDS=3
AV_POINTS=4
AV_REGISTER_MS=30000
AV_CHOICE_MS=60000
AV_ANSWER_MS=90000
AV_MIN_PLAYERS=2
AV_STATE_FILE=

# --- Un seul bot par groupe (plusieurs sessions / comptes WhatsApp) ---
# Delai pendant lequel un groupe reste au proprietaire deconnecte (ms).
GROUP_OWNER_GRACE_MS=600000
# Au demarrage, les sessions se connectent l'une apres l'autre : on ne
# considere pas les groupes comme orphelins pendant ce delai (ms).
GROUP_OWNER_STARTUP_MS=90000
# Duree de cache des metadonnees de groupe (admins, participants) (ms).
GROUP_OWNER_META_TTL_MS=300000
# Fichier du registre (sans extension), dans storage/database/.
GROUP_OWNER_FILE=group-ownership

# --- Statut automatique (citations amour/triste/motivation + media) ---
# Publie des statuts automatiquement depuis internet. Desactivable : AUTO_STATUS=off
AUTO_STATUS=on

# --- Mots interdits (antibadword) ---
# Inclure les insultes légères (abruti, idiot...) : true par défaut.
BADWORDS_LIGHT=true
# Catégories à expulsion immédiate (vide = avertissements classiques).
# Exemple : BADWORDS_KICK=menaces,haine
BADWORDS_KICK=

# --- Quiz, Loup-Garou et Mode nuit ---
# IA des jeux : off = banque locale uniquement.
GAMES_AI=on
# auto = IA puis banque locale | local = banque locale seulement | ia = IA seulement
QUIZ_SOURCE=auto
QUIZ_TIME_MS=25000
QUIZ_PAUSE_MS=3500
QUIZ_COUNT=10
QUIZ_MAX=30
QUIZ_POINTS=10
QUIZ_BONUS=5
QUIZ_ADMIN_ONLY=off

LG_MIN=5
LG_MAX=24
LG_LOBBY_MS=120000
LG_STEP_MS=45000
LG_DAY_MS=90000
LG_VOTE_MS=45000
LG_HUNTER_MS=30000
LG_REVEAL=on
LG_MUTE=on

# Fuseau par défaut du mode nuit (indépendant du serveur).
NIGHT_TZ=Africa/Douala
NIGHT_TICK_MS=30000

# --- Pronostics football (.promo) ---
# Fuseau d'affichage des heures de match (défaut : Africa/Douala).
PROMO_TZ=Africa/Douala
# Les cotes réelles viennent d'Infersports (gratuit, sans clé) :
# Crown, Sbobet, Macau, M8bet, Nova88, HKJC.
# Les pronostics/probabilités viennent de TipsAudit (gratuit, attribution).
# SportMonks (facultatif) : scores live et cotes bookmakers.
SPORTMONKS_API_KEY=
# Mise par defaut du ticket .promo, en FCFA (100 a 1 000 000).
PROMO_STAKE=1000
# Nombre de selections par defaut du ticket .promo (1 a 10).
PROMO_TICKET_SIZE=3
