# Variables d'environnement du projet VERCEL (site + fonctions api/).
# A renseigner dans Vercel : Project > Settings > Environment Variables
# (cocher Production ET Preview). Ne jamais mettre de valeur reelle dans ce fichier.

# URL publique HTTPS du service de jumelage local exposé via ngrok
# (ex. https://[DOMAINE].ngrok-free.app), sans chemin, sans slash final.
# Laisser vide si le front appelle directement le backend via PUBLIC_API_URL.
PAIRING_API_URL=

# Meme valeur que PAIRING_API_TOKEN cote backend local
PAIRING_API_TOKEN=

# Origine autorisee du site en production (recommande, ex. https://exemple.com).
# Si absent, l'origine est deduite de la requete (production/previews).
SITE_ORIGIN=

# URL publique de l'API backend (ngrok ou domaine API). Si definie, exposer via
# /api/config (PUBLIC_API_URL/NEXT_PUBLIC_API_URL/VITE_API_URL) et/ou renseigner
# web/public/js/config.js (window.DJS_API_BASE). Laisser vide pour mode proxy Vercel /api/*.
PUBLIC_API_URL=

# Cloudflare Turnstile (anti-spam formulaire de jumelage) - optionnel mais recommande.
# Configurer aussi la cle site cote front si integree.
TURNSTILE_SECRET_KEY=

