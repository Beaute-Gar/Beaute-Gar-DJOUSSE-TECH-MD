# Backend local (écoute 127.0.0.1 uniquement). NE PAS COMMITER .env (chmod 600 / ACL restreintes).
NODE_ENV=production
HOST=127.0.0.1
PORT=3001

# Origines autorisées (CORS strict, séparées par des virgules, sans wildcard)
# Ex: https://[A_REMPLIR].vercel.app,https://[A_REMPLIR]
ALLOWED_ORIGINS=https://[A_REMPLIR].vercel.app

# Auth (à remplacer par des secrets forts, rotation recommandée)
JWT_ACCESS_SECRET=[A_REMPLIR_SECRET_FORT]
JWT_REFRESH_SECRET=[A_REMPLIR_SECRET_FORT]
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Clés API machine-à-machine (hachées en base en production ; exemple de comparaison en temps constant)
# API_KEYS_HASHED=

# Anti-spam (optionnel)
TURNSTILE_SECRET_KEY=

# Journaux
LOG_LEVEL=info
LOG_FILE=./logs/api.log
